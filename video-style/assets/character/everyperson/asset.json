      "path": "poses/base.json",
      "role": "spec"
    },
    {
      "path": "poses/neutral.json",
      "role": "spec"
    },
    {
      "path": "poses/point.json",
      "role": "spec"
    },
    {
      "path": "poses/shrug.json",
      "role": "spec"
    },
    {
      "path": "SHEET.md",
      "role": "spec"
    }
  ],
  "implementation": {
    "kit_component": "InkShape",
    "props": {
      "shape": "character/everyperson/poses/base.json",
      "pose": "neutral"
    },
    "deterministic_inputs": [
      "shape files",
      "element seed"
    ]
  },
