{
  "$description": "Motion tokens. Durations are in FRAMES at 30 fps (convert with frames * fps / 30). Easing is cubic-bezier.",
  "motion": {
    "fps": {
      "$type": "number",
      "$value": 30
    },
    "duration": {
      "tick": {
        "$type": "number",
        "$value": 2
      },
      "quick": {
        "$type": "number",
        "$value": 6
      },
      "base": {
        "$type": "number",
        "$value": 12
      },
      "morph": {
        "$type": "number",
        "$value": 18
      },
      "slow": {
        "$type": "number",
        "$value": 24
      },
      "breath": {
        "$type": "number",
        "$value": 36
      },
      "caption-hold-min": {
        "$type": "number",
        "$value": 12
      },
      "scene-min": {
        "$type": "number",
        "$value": 36
      },
      "scene-max": {
        "$type": "number",
        "$value": 150
      },
      "hook-first-change-max": {
        "$type": "number",
        "$value": 15,
        "$description": "Something must visibly change within 0.5 s."
      }
    },
    "ease": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.45,
          0,
          0.2,
          1
        ],
        "$description": "Morphs, camera moves."
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "Arrivals (expo-out)."
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.7,
          0,
          0.84,
          0
        ],
        "$description": "Departures (expo-in)."
      },
      "draw": {
        "$type": "cubicBezier",
        "$value": [
          0.65,
          0,
          0.35,
          1
        ],
        "$description": "Stroke draw-on, thread travel."
      },
      "linear": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "Only for continuous drift and the pulse."
      }
    },
    "spring": {
      "settle": {
        "$type": "spring",
        "$value": {
          "damping": 14,
          "mass": 0.6,
          "stiffness": 120
        }
      },
      "pop": {
        "$type": "spring",
        "$value": {
          "damping": 10,
          "mass": 0.5,
          "stiffness": 180
        }
      }
    },
    "cadence": {
      "drawn-step": {
        "$type": "number",
        "$value": 2,
        "$description": "Hand-drawn elements update every 2nd frame (on twos)."
      },
      "thread-step": {
        "$type": "number",
        "$value": 1,
        "$description": "Thread, camera and text move on ones (smooth)."
      },
      "word-stagger": {
        "$type": "number",
        "$value": 3
      },
      "visual-change-interval-max": {
        "$type": "number",
        "$value": 75,
        "$description": "≤ 2.5 s without a visible change."
      }
    },
    "boil": {
      "amplitude-px": {
        "$type": "number",
        "$value": 0.9
      },
      "variants": {
        "$type": "number",
        "$value": 3
      }
    },
    "camera": {
      "push-scale": {
        "$type": "number",
        "$value": 1.06,
        "$description": "Slow push-in across a scene."
      },
      "zoom-through": {
        "$type": "number",
        "$value": 6.0,
        "$description": "Scale for zooming *into* an object to reach the next scene."
      }
    },
    "transition": {
      "$description": "Catalogue. Continuity transitions are the default; 'cut' is punctuation (≤ 3 per minute).",
      "morph": {
        "frames": 18,
        "ease": "standard",
        "use": "Object A becomes object B (shape/position/colour)."
      },
      "carry": {
        "frames": 18,
        "ease": "draw",
        "use": "The thread travels out of frame and pulls the next scene in."
      },
      "push": {
        "frames": 15,
        "ease": "standard",
        "use": "Camera pans along the thread to the next scene."
      },
      "draw-through": {
        "frames": 24,
        "ease": "draw",
        "use": "A line draws the next scene's outline over the old one, which fades."
      },
      "zoom-through": {
        "frames": 21,
        "ease": "standard",
        "use": "Push into a detail (eye, dot, word) until it becomes the next scene's background."
      },
      "wash": {
        "frames": 18,
        "ease": "enter",
        "use": "Watercolour bleed fills the frame, revealing the next mode/scene."
      },
      "cut": {
        "frames": 0,
        "ease": "linear",
        "use": "Punctuation on a beat / sound hit only."
      },
      "end-loop": {
        "frames": 18,
        "ease": "exit",
        "use": "Last scene only: fade stage and captions so the final frame matches the hook's first frame (seamless loop)."
      }
    }
  }
}
